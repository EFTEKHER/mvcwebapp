{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug mvcwebapp",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/mvcwebapp/mvcwebapp.csproj"
    },
    {
      "name": "Attach to running app (dotnet run)",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}
