
@using mvcwebapp.Models
@using mvcwebapp.Dtos
@model List<ProductDto>
@{
    ViewData["Title"] = "Dashboard";

    // Static sample data for now (later this will come from the database)
    
}

@if (ViewBag.Message != null)
{
    <div class="toast-container position-fixed top-0 end-0 p-3">
        <div id="messageToast" class="toast align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="3000">
            <div class="d-flex">
                <div class="toast-body">@ViewBag.Message</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Products</h2>
        <a class="btn btn-primary" asp-controller="Dashboard" asp-action="ProductForm">
            + Add Product
        </a>
    </div>

    <table class="table table-bordered table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Product Name</th>
                <th>Description</th>
                <th class="text-end">Price</th>
                <th>Color</th>
                <th class="text-center" style="width: 160px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if(Model.Count > 0)
            {
                foreach(var p in Model)
                {
                    <tr>
                        <td>@p.Id</td>
                        <td>@p.ProductName</td>
                        <td>@p.Description</td>
                        <td class="text-end">@p.price.ToString("0.00")</td>
                        <td>@p.color</td>
                        <td class="text-center">
                            <button type="button" class="btn btn-sm btn-warning">Edit</button>
                            <a type="button" class="btn btn-sm btn-danger" asp-action="DeleteProduct" asp-route-productId="@p.Id">Delete</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                
                    <td colspan="6" class="text-center">No products found.</td>
                
            }
            
        </tbody>
    </table>
</div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Bootstrap toasts are hidden until shown with JavaScript
        const messageToast = document.getElementById('messageToast');
        if (messageToast) {
            bootstrap.Toast.getOrCreateInstance(messageToast).show();
        }
    </script>
}
